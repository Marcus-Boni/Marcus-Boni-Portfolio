rules_version = '2';

// Security model for the portfolio admin:
//  • `content/site` — the editable portfolio content. Public read (the site
//    hydrates from it), authenticated write (only the admin can edit).
//  • `content/dossier` — editable AI dossier editorial notes & FAQs (falls back
//    to static defaults in `src/agent/knowledge.ts`). Public read, admin write.
//  • `messages` — contact-form submissions. Anyone can create, only the admin
//    can read / update / delete.
//  • `analytics` — visit + interaction events. Anyone can create, only the
//    admin can read. Never updated or deleted from the client.
//  • `settings/site` — site-wide toggles. Public read, admin write.
//  • `posts` — the blog. Public read of `published` and `unlisted` posts;
//    drafts are admin-only. Writes are always admin-only.
service cloud.firestore {
  match /databases/{database}/documents {
    // The admin is one specific account, named here rather than "anyone who
    // managed to authenticate".
    //
    // The Firebase web config is public by construction — every VITE_FIREBASE_*
    // value is inlined into the client bundle — so the API key identifies the
    // project to anyone who views source. If the Email/Password provider ever
    // allows self-signup,  would hand a stranger write
    // access to site content and read access to every contact message and
    // analytics event. Pinning the uid closes that regardless of the console
    // setting.
    //
    // The uid is an identifier, not a credential: it grants nothing without
    // authenticating as that account, which is why it is safe in a public repo.
    // Adding a second admin means adding their uid here and redeploying rules.

    function isAdmin() {

      return request.auth != null && request.auth.uid == 'FG69ZSmr9kZcA15R3fLaf4khAqm1';

    }

    // A post is publicly readable unless it is still a draft. `unlisted` stays
    // readable by direct link on purpose — it is how a study gets shared in a
    // meeting before (or without) going into the public index.
    function isReadable() {
      return resource.data.status in ['published', 'unlisted'];
    }

    function isValidPublicMessage() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'email', 'message', 'locale', 'read', 'createdAt',
          'referrerHost', 'country'
        ])
        && data.keys().hasAll(['name', 'email', 'message', 'locale', 'read', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
        && data.locale in ['pt', 'en']
        && data.read == false
        && data.createdAt == request.time
        && (!('referrerHost' in data) || (data.referrerHost is string && data.referrerHost.size() <= 120))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80));
    }

    function isValidAnalyticsEvent() {
      let data = request.resource.data;
      return data.keys().size() <= 24
        && data.keys().hasAll(['type', 'path', 'visitorId', 'sessionId', 'createdAt'])
        && data.type in [
          'pageview', 'section_view', 'outbound_click', 'cv_download',
          'contact_submit', 'language_change', 'blog_index_view',
          'post_view', 'post_read', 'post_share',
          'agent_open', 'agent_query', 'agent_fit', 'agent_handoff', 'agent_share'
        ]
        && data.path is string && data.path.size() >= 1 && data.path.size() <= 240
        && data.visitorId is string && data.visitorId.size() >= 4 && data.visitorId.size() <= 80
        && data.sessionId is string && data.sessionId.size() >= 4 && data.sessionId.size() <= 80
        && data.createdAt == request.time;
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{docId} {
      allow create: if isValidPublicMessage();
      allow read, update, delete: if isAdmin();
    }

    match /analytics/{docId} {
      allow create: if isValidAnalyticsEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /posts/{slug} {
      // On a list query Firestore proves this against the query constraints,
      // so the public index MUST filter `where('status', '==', 'published')`.
      // The admin listing skips the filter and passes via isAdmin().
      allow read: if isReadable() || isAdmin();
      allow write: if isAdmin();

      // The Markdown body. `status` is mirrored onto this document (written in
      // the same batch as the parent) specifically so this rule does not need
      // a get() on the parent — a rules get() bills a document read on every
      // request, which would double the cost of serving every post.
      match /content/{docId} {
        allow read: if isReadable() || isAdmin();
        allow write: if isAdmin();
      }
    }
  }
}
