# Global baseline HTTP security headers.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://*.firebasestorage.app https://i.ytimg.com https://lh3.googleusercontent.com; media-src 'self' blob: https://firebasestorage.googleapis.com https://*.firebasestorage.app; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.github.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Netlify cache headers.
# Everything under /assets/ carries a content hash in its filename, so it can
# be cached forever — a new deploy produces new filenames.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable-name static files: cache for a week, revalidate in the background.
/portrait-320.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/portrait-640.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-image.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/marcus-boni-cv-pt.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/marcus-boni-resume-en.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Machine-readable files. Agents fetch these first and re-fetch them often, so
# an hour of cache is worth more here than freshness — none of them changes
# without a deploy. `agent-instructions.md` gets an explicit Content-Type
# rather than trusting extension sniffing: a `.md` served as `text/plain` (or
# worse, downloaded) is a file an agent has to guess about.
/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/llms-full.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/agent-instructions.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# The API's static payloads and its specification. `/.well-known/api-catalog`
# has no file extension, so without this it would be served as a download
# rather than as the linkset RFC 9727 defines.
/openapi.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
/api/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

# The front-end kit. Its fonts are copies of the site's own (OFL), fixed by
# name, so they cache like the portrait. The downloads are files to keep, not
# pages: a shared direct link should save them, and none belongs in search.
/kit/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/kit/downloads/*
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Robots-Tag: noindex
/kit/downloads/kit-front-end.md
  Content-Type: text/markdown; charset=utf-8
/kit/downloads/front-end-kit.md
  Content-Type: text/markdown; charset=utf-8

# Management and machine endpoints are reachable without being search results.
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow
/agent/*
  X-Robots-Tag: noindex, nofollow
/404.html
  X-Robots-Tag: noindex

# The blog's RSS and sitemap are produced by netlify/edge-functions/feeds.ts,
# which sets its own Cache-Control — do not add rules for them here. The same
# goes for the Markdown representation of any HTML page: that comes from
# netlify/edge-functions/agents.ts, which sets Cache-Control and Vary itself.
