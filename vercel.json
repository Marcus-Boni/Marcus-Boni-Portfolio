{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/marcus-boni-cv.pdf",
      "destination": "/marcus-boni-cv-pt.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/developers", "destination": "/developers.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
