# ─── Firebase (admin + analytics) ──────────────────────────────────────────
# Create a project at https://console.firebase.google.com, add a Web App, and
# copy its config values here. Without these, the public site still runs on the
# static data in src/data/profile.ts and the /admin area stays in demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The blog's image uploads use Firebase Storage, which requires the **Blaze**
# plan. VITE_FIREBASE_PROJECT_ID is also read by the Netlify edge functions
# (per-post SEO, RSS, sitemap) — make sure it is exposed to functions, not just
# to the build. See docs/BLOG.md.

# ─── Server-side Dossier Edge LLM (NEVER prefix with VITE_) ────────────────
# Free providers are prioritized first (groq -> nvidia -> openrouter).
# Keep AGENT_FREE_ONLY=true in production so paid keys are never invoked.
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
AGENT_FREE_ONLY=true
AGENT_RATE_LIMIT_MAX=10
AGENT_RATE_LIMIT_WINDOW_S=60
AGENT_RATE_LIMIT_HOURLY=45
AGENT_GLOBAL_HOURLY_MAX=240
AGENT_ALLOWED_ORIGINS=https://marcusboni.com.br,https://www.marcusboni.com.br

# Optional higher GitHub API quota for /agent/v1/github (server-side only).
GITHUB_TOKEN=
